// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------
// COMPANY & SUBSCRIPTIONS
// -------------------------------
model Company {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  email            String         @unique
  stripeCustomerId String?
  trialEndsAt      DateTime?
  createdAt        DateTime       @default(now())
  sites            Site[]
  users            User[]
  subscription     Subscription?
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  stripePriceId String         @unique
  maxSites      Int            @default(10)
  features      String[]
  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(cuid())
  companyId        String    @unique
  company          Company   @relation(fields: [companyId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  stripeSubId      String?
  status           String    @default("incomplete")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
}

// -------------------------------
// SITES, VISITORS, HOSTS, EXPECTED
// -------------------------------
model Site {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  address            String?
  safetyBriefingText String            @default("Hard hat, high-vis vest, and safety glasses are mandatory. Stay in designated walkways.")
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id])
  visitors           VisitorLog[]
  hosts              Host[]
  expectedVisitors   ExpectedVisitor[]
  createdAt          DateTime          @default(now())
}

model VisitorLog {
  id                  String    @id @default(cuid())
  fullName            String
  company             String
  phone               String?
  email               String?
  hostName            String?
  safetyAcknowledged  Boolean   @default(false)
  signedInAt          DateTime  @default(now())
  signedOutAt         DateTime?
  siteId              String
  site                Site      @relation(fields: [siteId], references: [id])
}

model Host {
  id               String            @id @default(cuid())
  name             String
  email            String
  siteId           String
  site             Site              @relation(fields: [siteId], references: [id])
  expectedVisitors ExpectedVisitor[]
}

model ExpectedVisitor {
  id        String   @id @default(cuid())
  name      String
  company   String
  hostId    String?
  host      Host?    @relation(fields: [hostId], references: [id])
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  status    String   @default("pending") // pending, signed_in
  createdAt DateTime @default(now())
}

// -------------------------------
// USERS
// -------------------------------
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("company_owner") // "super_admin" or "company_owner"
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  createdAt    DateTime  @default(now())
}

// -------------------------------
// PASSWORD RESET
// -------------------------------
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}