// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------
// COMPANY & SUBSCRIPTIONS
// -------------------------------
model Company {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  email            String         @unique
  stripeCustomerId String?
  trialEndsAt      DateTime?
  apiKeyHash       String?
  trialEmailSequence String[]     @default([])
  createdAt        DateTime       @default(now())
  sites            Site[]
  users            User[]
  subscription     Subscription?
  slackWebhookUrl   String?          // ✅ Slack incoming webhook URL
  blocklistEntries BlocklistEntry[]
  webhookUrl             String?
}

model Plan {
  id            String         @id @default(cuid())
  name          String
  stripePriceId String         @unique
  maxSites      Int            @default(10)
  features      String[]
  subscriptions Subscription[]
}

model Subscription {
  id               String    @id @default(cuid())
  companyId        String    @unique
  company          Company   @relation(fields: [companyId], references: [id])
  planId           String
  plan             Plan      @relation(fields: [planId], references: [id])
  stripeSubId      String?
  status           String    @default("incomplete")
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
}

// -------------------------------
// SITES, VISITORS, HOSTS, EXPECTED
// -------------------------------
model Site {
  id                 String            @id @default(cuid())
  slug               String            @unique
  name               String
  address            String?
  safetyBriefingText String            @default("Hard hat, high-vis vest, and safety glasses are mandatory. Stay in designated walkways.")
  questions          String[]         @default([])
  companyId          String
  company            Company           @relation(fields: [companyId], references: [id])
  visitors           VisitorLog[]
  hosts              Host[]
  expectedVisitors   ExpectedVisitor[]
  createdAt          DateTime          @default(now())
  documentSigningEnabled Boolean  @default(false)
documentTemplateUrl    String?
}

model VisitorLog {
  id                  String    @id @default(cuid())
  fullName            String
  company             String
  phone               String?
  email               String?
  hostName            String?
  safetyAcknowledged  Boolean   @default(false)
  signedInAt          DateTime  @default(now())
  signedOutAt         DateTime?
  answers             Json?     // ✅ pre‑screening answers (question → boolean)
  siteId              String
  site                Site      @relation(fields: [siteId], references: [id])
  photoUrl            String?          // ✅ URL of the visitor's photo
  signatureUrl           String?
}

model Host {
  id               String            @id @default(cuid())
  name             String
  email            String
  siteId           String
  site             Site              @relation(fields: [siteId], references: [id])
  expectedVisitors ExpectedVisitor[]
}

model ExpectedVisitor {
  id        String   @id @default(cuid())
  name      String
  company   String
  hostId    String?
  host      Host?    @relation(fields: [hostId], references: [id])
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id])
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

// -------------------------------
// USERS
// -------------------------------
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("company_owner")
  verified     Boolean   @default(false)
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id])
  createdAt    DateTime  @default(now())
}

// -------------------------------
// PASSWORD RESET & VERIFICATION
// -------------------------------
model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model VerificationToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// -------------------------------
// CHECKLIST REQUESTS
// -------------------------------
model ChecklistRequest {
  id        String   @id @default(cuid())
  email     String
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  data      Json?    // optional extra info like { format: "csv" }
  createdAt DateTime @default(now())
}

model BlocklistEntry {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  value     String   // name, email, or phone
  type      String   // "name", "email", "phone"
  note      String?
  createdAt DateTime @default(now())
}